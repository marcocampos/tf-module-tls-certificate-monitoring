# Terraform state & working dirs
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config / plans
.terraformrc
terraform.rc
*.tfplan

# Claude Code local settings
.claude/settings.local.json
